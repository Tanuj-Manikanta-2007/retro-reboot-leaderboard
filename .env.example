# ==============================================================================
# RETRO REBOOT BY COGAAN - ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT store real production secrets in this example file.
# ==============================================================================

# Supabase Public Keys (Safe for browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Privileged Service Role Key (SERVER-SIDE ONLY - Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Event Master Access Gate PINs
# SHA-256 hash of Admin PIN
EVENT_ADMIN_PIN_HASH=your-admin-pin-sha256-hash

# SHA-256 hash of Volunteer PIN
EVENT_VOLUNTEER_PIN_HASH=your-volunteer-pin-sha256-hash

# Ephemeral PIN Session Signing Secret (Random 32+ char secret)
PIN_SESSION_SECRET=cogaan_retro_reboot_session_secret_change_in_production_2026

# Protected Database Flush Master Password (SERVER-SIDE ONLY - Never expose to client)
FLUSH_PASSWORD=your_secure_flush_password_here
